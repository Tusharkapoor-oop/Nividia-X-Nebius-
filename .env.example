# UpgradePilot environment variables
# Copy this file to .env and fill in your keys.
# .env is git-ignored and must never be committed.

# Nebius Token Factory key — required when LLM_PROVIDER=tokenfactory.
# Create at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=

# NVIDIA NIM / build.nvidia.com key — required when LLM_PROVIDER=nvidia-nim.
# Create at https://build.nvidia.com/ (key starts with nvapi-).
NVIDIA_API_KEY=

# LLM provider. tokenfactory = Nebius Token Factory (submission path;
# USD-capped from the live catalog). nvidia-nim = NVIDIA NIM (local
# development only; NOT eligible for the hackathon; unpriced, capped by
# MAX_LLM_CALLS_PER_RUN).
LLM_PROVIDER=tokenfactory

# Required: Tavily search API key
# Get one at https://tavily.com/
TAVILY_API_KEY=

# Optional: Token Factory endpoints (verified against the live catalog)
TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
TOKENFACTORY_CATALOG_URL=https://tokenfactory.nebius.com/api/public/models_info

# Optional: NVIDIA NIM endpoint (used when LLM_PROVIDER=nvidia-nim)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: tier model selection. In tokenfactory mode these must exist in the
# live catalog. For local nvidia-nim development use the build.nvidia.com ids:
#   MODEL_TIER_CHEAP=nvidia/nemotron-3.5-lightning-30b-a3b
#   MODEL_TIER_DEFAULT=nvidia/nemotron-3.5-lightning-30b-a3b
#   MODEL_TIER_STRONG=nvidia/nemotron-3-ultra-550b-a55b
# (The trial NVIDIA API account verified on 2026-10-21 exposes Lightning and
# Ultra; the smaller Nano/Super ids returned 404/degraded. Set these in the
# process environment, or your local .env, only for development.)
MODEL_TIER_CHEAP=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_TIER_DEFAULT=nvidia/Nemotron-3_5-Lightning
MODEL_TIER_STRONG=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: maximum USD spend per run before halting (tokenfactory mode)
TOKEN_COST_CAP_USD=2.00

# Optional: hard cap on chat calls per run (nvidia-nim mode, where USD cap
# is unavailable)
MAX_LLM_CALLS_PER_RUN=12

# Optional: maximum total seconds for a single pytest invocation
PYTEST_TIMEOUT_SECONDS=300

# Optional: maximum agent-loop iterations and escalation threshold
MAX_ITERATIONS=5
ESCALATE_AFTER=2
